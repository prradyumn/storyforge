# Copy to .env — never commit the real file.

# LLM backends, tried in this order. Use "stub" for offline demos and tests.
STORYFORGE_BACKEND=gemini,groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Which prompt version the pipeline uses by default (v1 | v2 | v3)
STORYFORGE_PROMPT_VERSION=v3

# Jira Cloud (optional — without these, publishing is dry-run only)
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SCRUM

# Hugging Face Space deploy (scripts/deploy_hf.sh)
HF_TOKEN=
HF_USER=
HF_SPACE=storyforge

# Public-demo guards
STORYFORGE_DAILY_LIVE_LIMIT=40
STORYFORGE_ADMIN_KEY=
