# Copy to .env — never commit the real file.

# LLM backends, tried in this order. Use "stub" for offline demos and tests.
STORYFORGE_BACKEND=groq,gemini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Which prompt version the pipeline uses by default (v1 | v2 | v3)
STORYFORGE_PROMPT_VERSION=v3

# Jira Cloud (optional — without these, publishing is dry-run only)
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SCRUM
